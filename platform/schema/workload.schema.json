{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bruma.io/schema/workload.schema.json",
  "title": "Bruma Workload",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],

  "properties": {
    "apiVersion": {
      "const": "bruma.io/v1"
    },
    "kind": {
      "const": "Workload"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "environment"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "environment": {
          "enum": ["local", "development", "production"]
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "replicas"],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 1
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "$ref": "#/$defs/resources"
            },
            "limits": {
              "$ref": "#/$defs/resources"
            }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "host": {
              "type": "string"
            }
          }
        },
        "observability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    }
  },

  "$defs": {
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "type": "string",
          "pattern": "^([0-9]+m|([0-9]+([.][0-9]+)?))$"
        },
        "memory": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi)$"
        }
      }
    }
  }
}